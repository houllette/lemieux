#!/bin/sh
# Usage: deploy ENV [--preview]
# Deploys the current build to ENV. With --preview, prints what would happen
# and changes nothing.
set -u
usage() { echo "usage: deploy ENV [--preview]" >&2; exit 2; }
[ $# -ge 1 ] || usage
env=$1
shift
preview=0
for arg in "$@"; do
  case "$arg" in
    --preview) preview=1 ;;
    *) echo "deploy: unknown option: $arg" >&2; usage ;;
  esac
done
case "$env" in
  staging|production) ;;
  *) echo "deploy: unknown environment: $env" >&2; exit 2 ;;
esac
if [ "$preview" = 1 ]; then
  echo "would deploy build to $env"
else
  echo "deploying build to $env"
fi
