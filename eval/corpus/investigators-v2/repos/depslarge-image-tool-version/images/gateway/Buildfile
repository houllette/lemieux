# image recipe for gateway
FROM base-image:2026.06
ARG FMTCHECK_VERSION=0.10.10
ARG LINTKIT_VERSION=2.12.16
ARG BUNDLER_VERSION=0.10.16
ARG SIGTOOL_VERSION=1.10.12
ARG COMPRESSOR_VERSION=0.9.11
ARG MINIFIER_VERSION=0.7.20
ARG SCHEMAGEN_VERSION=4.6.3
ARG DOCGEN_VERSION=4.11.16
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/gateway
