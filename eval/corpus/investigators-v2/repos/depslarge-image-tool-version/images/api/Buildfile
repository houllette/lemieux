# image recipe for api
FROM base-image:2026.06
ARG FMTCHECK_VERSION=2.0.0
ARG LINTKIT_VERSION=1.7.17
ARG BUNDLER_VERSION=0.5.15
ARG SIGTOOL_VERSION=3.2.8
ARG COMPRESSOR_VERSION=3.5.9
ARG MINIFIER_VERSION=2.12.16
ARG SCHEMAGEN_VERSION=3.0.8
ARG DOCGEN_VERSION=3.4.0
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/api
