# image recipe for worker
FROM base-image:2026.06
ARG FMTCHECK_VERSION=3.11.16
ARG LINTKIT_VERSION=2.6.19
ARG BUNDLER_VERSION=0.9.8
ARG SIGTOOL_VERSION=4.9.13
ARG COMPRESSOR_VERSION=3.5.10
ARG MINIFIER_VERSION=3.4.12
ARG SCHEMAGEN_VERSION=2.8.8
ARG DOCGEN_VERSION=2.11.20
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/worker
