# image recipe for cli
FROM base-image:2026.06
ARG FMTCHECK_VERSION=0.10.7
ARG LINTKIT_VERSION=2.9.2
ARG BUNDLER_VERSION=1.8.10
ARG SIGTOOL_VERSION=2.10.20
ARG COMPRESSOR_VERSION=2.10.1
ARG MINIFIER_VERSION=0.2.14
ARG SCHEMAGEN_VERSION=1.12.16
ARG DOCGEN_VERSION=0.11.17
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/cli
