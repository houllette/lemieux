# image recipe for worker
FROM base-image:2026.06
ARG FMTCHECK_VERSION=0.5.12
ARG LINTKIT_VERSION=0.8.6
ARG BUNDLER_VERSION=3.5.1
ARG SIGTOOL_VERSION=2.9.7
ARG COMPRESSOR_VERSION=3.6.8
ARG MINIFIER_VERSION=1.11.20
ARG SCHEMAGEN_VERSION=2.7.11
ARG DOCGEN_VERSION=0.9.9
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/worker
