# image recipe for cli
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.6.3
ARG LINTKIT_VERSION=1.5.7
ARG BUNDLER_VERSION=0.7.4
ARG SIGTOOL_VERSION=1.1.0
ARG COMPRESSOR_VERSION=3.3.16
ARG MINIFIER_VERSION=2.9.5
ARG SCHEMAGEN_VERSION=1.3.9
ARG DOCGEN_VERSION=3.4.5
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/cli
