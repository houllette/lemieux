# image recipe for gateway
FROM base-image:2026.06
ARG FMTCHECK_VERSION=3.4.13
ARG LINTKIT_VERSION=2.3.14
ARG BUNDLER_VERSION=2.6.1
ARG SIGTOOL_VERSION=0.12.2
ARG COMPRESSOR_VERSION=3.5.7
ARG MINIFIER_VERSION=4.1.18
ARG SCHEMAGEN_VERSION=3.0.17
ARG DOCGEN_VERSION=4.9.10
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/gateway
