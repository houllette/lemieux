# image recipe for api
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.3.19
ARG LINTKIT_VERSION=1.3.12
ARG BUNDLER_VERSION=2.5.6
ARG SIGTOOL_VERSION=2.8.12
ARG COMPRESSOR_VERSION=0.6.16
ARG MINIFIER_VERSION=0.10.1
ARG SCHEMAGEN_VERSION=0.4.16
ARG DOCGEN_VERSION=3.9.12
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/api
