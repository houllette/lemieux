# image recipe for cli
FROM base-image:2026.06
ARG FMTCHECK_VERSION=4.6.20
ARG LINTKIT_VERSION=4.12.3
ARG BUNDLER_VERSION=4.2.2
ARG SIGTOOL_VERSION=0.7.10
ARG COMPRESSOR_VERSION=2.1.9
ARG MINIFIER_VERSION=0.10.4
ARG SCHEMAGEN_VERSION=3.4.3
ARG DOCGEN_VERSION=3.0.0
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/cli
