# image recipe for worker
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.9.2
ARG LINTKIT_VERSION=3.3.6
ARG BUNDLER_VERSION=4.0.7
ARG SIGTOOL_VERSION=2.9.14
ARG COMPRESSOR_VERSION=1.11.3
ARG MINIFIER_VERSION=3.10.4
ARG SCHEMAGEN_VERSION=1.8.1
ARG DOCGEN_VERSION=0.12.19
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/worker
