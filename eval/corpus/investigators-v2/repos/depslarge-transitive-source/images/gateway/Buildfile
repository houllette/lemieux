# image recipe for gateway
FROM base-image:2026.06
ARG FMTCHECK_VERSION=0.9.13
ARG LINTKIT_VERSION=2.7.14
ARG BUNDLER_VERSION=3.1.15
ARG SIGTOOL_VERSION=4.12.9
ARG COMPRESSOR_VERSION=1.2.20
ARG MINIFIER_VERSION=0.12.5
ARG SCHEMAGEN_VERSION=0.9.3
ARG DOCGEN_VERSION=4.1.6
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/gateway
