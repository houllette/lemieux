# image recipe for api
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.1.13
ARG LINTKIT_VERSION=2.9.11
ARG BUNDLER_VERSION=4.7.6
ARG SIGTOOL_VERSION=4.12.19
ARG COMPRESSOR_VERSION=3.2.12
ARG MINIFIER_VERSION=0.5.18
ARG SCHEMAGEN_VERSION=1.10.17
ARG DOCGEN_VERSION=2.6.11
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/api
