# image recipe for cli
FROM base-image:2026.06
ARG FMTCHECK_VERSION=3.6.11
ARG LINTKIT_VERSION=1.6.6
ARG BUNDLER_VERSION=2.8.6
ARG SIGTOOL_VERSION=2.5.14
ARG COMPRESSOR_VERSION=1.5.10
ARG MINIFIER_VERSION=0.10.16
ARG SCHEMAGEN_VERSION=1.10.18
ARG DOCGEN_VERSION=3.4.12
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/cli
