# image recipe for api
FROM base-image:2026.06
ARG FMTCHECK_VERSION=2.0.17
ARG LINTKIT_VERSION=1.6.7
ARG BUNDLER_VERSION=2.8.15
ARG SIGTOOL_VERSION=4.11.1
ARG COMPRESSOR_VERSION=4.0.14
ARG MINIFIER_VERSION=1.4.20
ARG SCHEMAGEN_VERSION=2.3.9
ARG DOCGEN_VERSION=4.10.7
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/api
