# image recipe for gateway
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.10.8
ARG LINTKIT_VERSION=2.1.17
ARG BUNDLER_VERSION=3.8.13
ARG SIGTOOL_VERSION=2.9.20
ARG COMPRESSOR_VERSION=2.2.16
ARG MINIFIER_VERSION=3.4.2
ARG SCHEMAGEN_VERSION=4.6.12
ARG DOCGEN_VERSION=2.4.9
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/gateway
