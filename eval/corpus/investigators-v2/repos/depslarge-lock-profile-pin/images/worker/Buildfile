# image recipe for worker
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.9.19
ARG LINTKIT_VERSION=0.11.18
ARG BUNDLER_VERSION=3.11.12
ARG SIGTOOL_VERSION=4.12.0
ARG COMPRESSOR_VERSION=4.6.12
ARG MINIFIER_VERSION=3.9.5
ARG SCHEMAGEN_VERSION=4.8.17
ARG DOCGEN_VERSION=4.2.14
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/worker
