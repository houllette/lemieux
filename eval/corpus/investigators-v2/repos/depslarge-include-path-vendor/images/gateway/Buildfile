# image recipe for gateway
FROM base-image:2026.06
ARG FMTCHECK_VERSION=2.3.14
ARG LINTKIT_VERSION=3.10.10
ARG BUNDLER_VERSION=2.12.19
ARG SIGTOOL_VERSION=3.0.18
ARG COMPRESSOR_VERSION=4.12.10
ARG MINIFIER_VERSION=2.2.6
ARG SCHEMAGEN_VERSION=1.0.10
ARG DOCGEN_VERSION=1.5.14
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/gateway
