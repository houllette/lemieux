# image recipe for cli
FROM base-image:2026.06
ARG FMTCHECK_VERSION=1.0.16
ARG LINTKIT_VERSION=4.7.10
ARG BUNDLER_VERSION=0.4.1
ARG SIGTOOL_VERSION=4.1.9
ARG COMPRESSOR_VERSION=0.5.13
ARG MINIFIER_VERSION=2.7.13
ARG SCHEMAGEN_VERSION=0.12.13
ARG DOCGEN_VERSION=2.7.2
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/cli
