# image recipe for worker
FROM base-image:2026.06
ARG FMTCHECK_VERSION=3.1.6
ARG LINTKIT_VERSION=1.2.1
ARG BUNDLER_VERSION=3.11.10
ARG SIGTOOL_VERSION=3.12.6
ARG COMPRESSOR_VERSION=4.9.14
ARG MINIFIER_VERSION=2.7.19
ARG SCHEMAGEN_VERSION=2.10.7
ARG DOCGEN_VERSION=4.0.9
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/worker
