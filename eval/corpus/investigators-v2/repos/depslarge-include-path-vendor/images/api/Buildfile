# image recipe for api
FROM base-image:2026.06
ARG FMTCHECK_VERSION=3.8.6
ARG LINTKIT_VERSION=2.4.19
ARG BUNDLER_VERSION=3.5.10
ARG SIGTOOL_VERSION=0.3.3
ARG COMPRESSOR_VERSION=0.0.2
ARG MINIFIER_VERSION=1.4.18
ARG SCHEMAGEN_VERSION=1.10.18
ARG DOCGEN_VERSION=2.5.6
RUN install-tool fmtcheck ${FMTCHECK_VERSION}
RUN install-tool lintkit ${LINTKIT_VERSION}
COPY . /srv/api
