  {
    "family": "patch",
    "contract": "Apply atomic dictionary-only patch operations. Paths start with / and use JSON Pointer ~1 for slash and ~0 for tilde. Empty keys are legal. Every intermediate key must exist and name a dictionary. set creates/replaces a final key; remove requires an existing key; test requires an existing key equal to value. On any invalid path/op/test return {ok:false,document:original}, undoing earlier operations. Otherwise return {ok:true,document:updated}. Preserve input objects. Lists are values, not traversable containers.",
    "cases": [
      [
        {
          "document": {
            "a": 1
          },
          "operations": [
            {
              "op": "set",
              "path": "/a",
              "value": 2
            }
          ]
        },
        {
          "ok": true,
          "document": {
            "a": 2
          }
        }
      ],
      [
        {
          "document": {
            "a": 1
          },
          "operations": [
            {
              "op": "set",
              "path": "/a",
              "value": 2
            },
            {
              "op": "test",
              "path": "/a",
              "value": 1
            }
          ]
        },
        {
          "ok": false,
          "document": {
            "a": 1
          }
        }
      ],
      [
        {
          "document": {
            "a/b": {
              "~": 1
            }
          },
          "operations": [
            {
              "op": "set",
              "path": "/a~1b/~0",
              "value": 9
            }
          ]
        },
        {
          "ok": true,
          "document": {
            "a/b": {
              "~": 9
            }
          }
        }
      ],
      [
        {
          "document": {},
          "operations": [
            {
              "op": "remove",
              "path": "/missing"
            }
          ]
        },
        {
          "ok": false,
          "document": {}
        }
      ],
      [
        {
          "document": {
            "a": []
          },
          "operations": [
            {
              "op": "set",
              "path": "/a/0",
              "value": 9
            }
          ]
        },
        {
          "ok": false,
          "document": {
            "a": []
          }
        }
      ],
      [
        {
          "document": {},
          "operations": [
            {
              "op": "set",
              "path": "/",
              "value": 7
            }
          ]
        },
        {
          "ok": true,
          "document": {
            "": 7
          }
        }
      ],
      [
